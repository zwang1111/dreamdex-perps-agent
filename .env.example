# dreamDEX Perps Agent — Hideki / Tokyo testnet (NEVER commit a real .env)
# Copy to bot-kit/.env:
#   cp .env.example bot-kit/.env
#
# Generate a BOT key (not your main wallet):
#   cast wallet new
# or any EOA. Link it in https://app.testnet.dreamdex.io → wallet → Link a bot → Perps.
# Fill PRIVATE_KEY with the bot key; OWNER_ADDRESS with your DreamDEX account.
# Leave placeholders as-is until you have real values — do not invent funded keys.

# ── Required for live / doctor-with-wallet ──────────────────────────────────
PRIVATE_KEY=0x_REPLACE_WITH_BOT_KEY_NEVER_MAIN_WALLET
# DreamDEX account the bot is linked to (trading-key mode). Leave blank to trade
# the key's own MarginBank instead (then that key needs USDso + gas).
OWNER_ADDRESS=0x_REPLACE_WITH_YOUR_DREAMDEX_ACCOUNT

# ── Network (perps default) ─────────────────────────────────────────────────
# hideki = Tokyo / Hideki testnet, chain 50383 (Perps Arena + app.testnet.dreamdex.io)
# testnet = Shannon (50312). mainnet is refused for perps.
NETWORK=hideki
# Optional overrides (kit has defaults):
# RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# Note: Shannon faucet RPC is often https://dream-rpc.somnia.network — Hideki uses the hideki2 infra RPC above.

# ── Safety ──────────────────────────────────────────────────────────────────
# Keep true until dry-run logs look right. Live orders only when false + funded.
DRY_RUN=true

# ── perp-starter knobs ──────────────────────────────────────────────────────
PERP_SYMBOL=ETH-PERP
PERP_SIDE=long
PERP_LEVERAGE=2
# Position VALUE in USDso, not margin. At 2x, 20 notional ≈ 10 margin.
PERP_NOTIONAL_USDSO=20
PERP_TAKE_PROFIT_PCT=2
PERP_STOP_LOSS_PCT=1
PERP_TICK_MS=10000
# PERP_FLATTEN_ON_EXIT=true

# ── optional: perp-guard (run separately) ───────────────────────────────────
# PERP_GUARD_REDUCE_BELOW=1.5
# PERP_GUARD_REDUCE_PCT=25
# PERP_GUARD_FLATTEN_BELOW=1.15
# PERP_GUARD_POLL_MS=30000
